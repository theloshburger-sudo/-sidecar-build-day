# Required for live AI tutoring. Get one at https://console.anthropic.com/ -> API Keys.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 (fast + smart). Try claude-opus-5-5 for max quality.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Lets Sidecar show real YouTube video cards instead of search links.
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=

# Optional. A natural, human-sounding voice for Teacher (ElevenLabs). Free plan: elevenlabs.io -> Profile -> API Keys.
# Without it, Teacher uses the best voice built into the browser.
ELEVENLABS_API_KEY=
# Optional. Pick any voice from your ElevenLabs Voice Library (copy its Voice ID).
ELEVENLABS_VOICE_ID=
